{
  "source": "cxlmemsim",
  "target_arch": "amd64",
  "compiler": {
    "cc": "clang",
    "cxx": "clang++"
  },
  "cmake": {
    "build_type": "Release",
    "policy_default_cmp0091": "NEW",
    "definitions": {
      "CXLMEMSIM_BUILD_MICROBENCHMARKS": "OFF",
      "CXLMEMSIM_ENABLE_RDMA": "OFF",
      "CXLMEMSIM_ENABLE_SLUGALLOCATOR": "OFF"
    },
    "targets": [
      "cxlmemsim_server"
    ],
    "parallel": 4
  },
  "guest_shim": {
    "make_targets": [
      "libcuda.so.1",
      "libcuda.so",
      "libcxl-loader-audit.so",
      "cxl-gpu-case",
      "cxl-mem-active-gate",
      "integrity-export-oracle",
      "test",
      "test-static-collector",
      "test-cublas-create-probe"
    ],
    "cc": "clang",
    "cflags": [
      "-O2",
      "-Wall",
      "-Wextra"
    ],
    "tiny_cuda": {
      "target": "tiny-probe",
      "nvcc": "nvcc",
      "host_cxx": "g++",
      "arch": "sm_89"
    }
  },
  "outputs": [
    {
      "path": "evidence/cuda-api/cxl_gpu_cmd.h",
      "type": "file",
      "mode": "0644"
    },
    {
      "path": "evidence/cuda-api/cxl_type2_accel.h",
      "type": "file",
      "mode": "0644"
    },
    {
      "path": "evidence/cuda-api/cxl_cuda_observation.h",
      "type": "file",
      "mode": "0644"
    },
    {
      "path": "evidence/cuda-api/libcuda.c",
      "type": "file",
      "mode": "0644"
    },
    {
      "path": "evidence/cuda-api/collect_cuda_elf_static_evidence.py",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "bin/cxlmemsim_server",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "bin/cuda-integrity-export-oracle",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "lib/libfmt.so.9",
      "type": "file",
      "mode": "0644"
    },
    {
      "path": "guest/libcuda.so.1",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/libcxl-loader-audit.so",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/libcuda.so",
      "type": "symlink",
      "mode": "0777",
      "link_target": "libcuda.so.1"
    },
    {
      "path": "guest/cxl-gpu-case",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/cxl-mem-active-gate",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/cuda-runtime-dlopen-kernel-probe",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/libtiny_cuda.so",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/libcublas_create_probe.so",
      "type": "file",
      "mode": "0755"
    },
    {
      "path": "guest/libbatch_copy_probe.so",
      "type": "file",
      "mode": "0755"
    }
  ]
}
